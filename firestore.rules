rules_version = '2';

// Regra geral: tudo negado. Cada coleção abre só o necessário.
// Campos sensíveis (créditos, assinatura, pedidos, pagamentos, papel) só o servidor escreve (Admin SDK ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu(uid) { return logado() && request.auth.uid == uid; }
    function dono() { return logado() && resource.data.donoId == request.auth.uid; }
    function novoDono() { return logado() && request.resource.data.donoId == request.auth.uid; }
    function soMudou(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    function textoAte(v, max) { return v is string && v.size() <= max; }
    // Mesma regra de src/lib/acesso.ts: só quem pagou um plano (ou tem cortesia) cria conteúdo.
    function liberado() {
      let a = get(/databases/$(database)/documents/assinaturas/$(request.auth.uid)).data;
      return a.get('cortesia', false) == true || a.get('status', '') in ['ativa', 'inadimplente']
        || (a.get('status', '') == 'cancelada' && a.get('renovaEm', request.time) > request.time);
    }

    match /usuarios/{uid} {
      allow read: if eu(uid);
      allow create: if eu(uid)
        && request.resource.data.keys().hasOnly(['nome', 'email', 'criadoEm', 'aceite'])
        && textoAte(request.resource.data.nome, 120)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.criadoEm == request.time
        && request.resource.data.aceite.versao is string
        && request.resource.data.aceite.em == request.time;
      allow update: if eu(uid) && soMudou(['nome']) && textoAte(request.resource.data.nome, 120);
      allow delete: if false;
    }

    match /produtos/{id} {
      function produtoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['donoId', 'titulo', 'status', 'etapa', 'configuracao', 'planejamento', 'planejamentoAprovado', 'identidade', 'oferta', 'criadoEm', 'atualizadoEm'])
          && textoAte(d.titulo, 120)
          && d.status in ['rascunho', 'em_edicao']   // 'publicado' só o servidor marca (Etapa 5)
          && d.etapa is int && d.etapa >= 0 && d.etapa <= 8
          && d.configuracao is map
          && (!('planejamento' in d) || d.planejamento == null || d.planejamento is map)
          && (!('planejamentoAprovado' in d) || d.planejamentoAprovado is bool)
          && (!('identidade' in d) || d.identidade is map)
          && (!('oferta' in d) || (d.oferta is map && d.oferta.precoCentavos is int && d.oferta.precoCentavos >= 500 && d.oferta.precoCentavos <= 500000))
          && d.atualizadoEm == request.time;
      }
      allow read: if dono();
      allow create: if novoDono() && produtoValido() && request.resource.data.criadoEm == request.time && liberado();
      allow update: if dono() && novoDono() && produtoValido()
        && request.resource.data.criadoEm == resource.data.criadoEm
        && resource.data.status != 'publicado';
      allow delete: if dono() && resource.data.status != 'publicado';
    }

    // Capítulos: um documento por capítulo, sempre ligado a um produto do próprio dono.
    match /capitulos/{id} {
      function capituloValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['donoId', 'produtoId', 'ordem', 'titulo', 'status', 'conteudo', 'resumo', 'problemas', 'revisaoAplicada', 'erro', 'editadoManualmente', 'atualizadoEm'])
          && d.ordem is int && d.ordem >= 0 && d.ordem < 60
          && textoAte(d.titulo, 200)
          && d.status in ['pendente', 'gerando', 'concluido', 'erro']
          && (!('conteudo' in d) || textoAte(d.conteudo, 300000))
          && (!('resumo' in d) || textoAte(d.resumo, 4000))
          && d.atualizadoEm == request.time
          && get(/databases/$(database)/documents/produtos/$(d.produtoId)).data.donoId == request.auth.uid;
      }
      allow read: if dono();
      allow create: if novoDono() && capituloValido() && liberado();
      allow update: if dono() && novoDono() && capituloValido() && request.resource.data.produtoId == resource.data.produtoId;
      allow delete: if dono();
    }

    // Imagens geradas: o arquivo fica no Storage (criadores/{uid}/...); aqui só o registro.
    match /imagens/{id} {
      allow read, delete: if dono();
      allow create: if novoDono()
        && request.resource.data.keys().hasOnly(['donoId', 'produtoId', 'tipo', 'ordem', 'url', 'caminho', 'prompt', 'criadoEm'])
        && request.resource.data.tipo in ['capa', 'capitulo']
        && request.resource.data.ordem is int
        && request.resource.data.url is string && request.resource.data.url.matches('https://firebasestorage[.]googleapis[.]com/.*')
        && request.resource.data.caminho.matches('criadores/' + request.auth.uid + '/.*')
        && textoAte(request.resource.data.prompt, 4000)
        && request.resource.data.criadoEm == request.time
        && get(/databases/$(database)/documents/produtos/$(request.resource.data.produtoId)).data.donoId == request.auth.uid;
    }

    // Versões do PDF: o arquivo fica no Storage do criador; aqui o histórico.
    match /arquivos/{id} {
      allow read: if dono();
      allow create: if novoDono()
        && request.resource.data.keys().hasOnly(['donoId', 'produtoId', 'versao', 'url', 'caminho', 'paginas', 'bytes', 'rascunho', 'criadoEm'])
        && request.resource.data.versao is int
        && request.resource.data.url.matches('https://firebasestorage[.]googleapis[.]com/.*')
        && request.resource.data.caminho.matches('criadores/' + request.auth.uid + '/.*')
        && request.resource.data.criadoEm == request.time
        && get(/databases/$(database)/documents/produtos/$(request.resource.data.produtoId)).data.donoId == request.auth.uid;
    }

    // Divulgação: o id da campanha é o id do produto (uma campanha por produto).
    match /campanhas/{produtoId} {
      function campanhaValida() {
        let d = request.resource.data;
        return novoDono()
          && d.produtoId == produtoId
          && d.keys().hasOnly(['donoId', 'produtoId', 'dados', 'dataInicio', 'feitos', 'atualizadoEm'])
          && d.dados is map
          && d.dataInicio is string && d.dataInicio.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.feitos is list && d.feitos.size() <= 100
          && d.atualizadoEm == request.time
          && get(/databases/$(database)/documents/produtos/$(produtoId)).data.donoId == request.auth.uid;
      }
      // resource == null: produto ainda sem campanha; a consulta por id não pode virar erro de permissão.
      allow read: if logado() && (resource == null || dono());
      allow delete: if dono();
      allow create: if campanhaValida();
      allow update: if dono() && campanhaValida();
    }

    // Criativos: as imagens ficam no Storage do criador; aqui os textos e os endereços.
    match /criativos/{id} {
      function urlOuVazia(v) { return v == null || (v is string && v.matches('https://firebasestorage[.]googleapis[.]com/.*')); }
      function caminhoOuVazio(v) { return v == null || (v is string && v.matches('criadores/' + request.auth.uid + '/.*')); }
      function criativoValido() {
        let d = request.resource.data;
        return novoDono()
          && d.keys().hasOnly(['donoId', 'produtoId', 'formato', 'midia', 'tipoGancho', 'emocao', 'comoUsar', 'plataforma', 'angulo', 'titulo', 'apoio', 'textoPrincipal', 'legenda', 'cta', 'usarMockup', 'promptArte', 'urlFundo', 'caminhoFundo', 'urlFinal', 'caminhoFinal', 'status', 'criadoEm', 'atualizadoEm'])
          && d.formato in ['quadrado', 'retrato', 'story']
          && d.status in ['pendente', 'pronto', 'erro']
          && d.usarMockup is bool
          && textoAte(d.plataforma, 80) && textoAte(d.angulo, 300) && textoAte(d.titulo, 100) && textoAte(d.apoio, 160)
          && textoAte(d.textoPrincipal, 3000) && textoAte(d.legenda, 3000) && textoAte(d.cta, 40) && textoAte(d.promptArte, 4000)
          && urlOuVazia(d.urlFundo) && urlOuVazia(d.urlFinal) && caminhoOuVazio(d.caminhoFundo) && caminhoOuVazio(d.caminhoFinal)
          && d.atualizadoEm == request.time;
      }
      allow read, delete: if dono();
      allow create: if criativoValido() && request.resource.data.criadoEm == request.time
        && get(/databases/$(database)/documents/produtos/$(request.resource.data.produtoId)).data.donoId == request.auth.uid;
      allow update: if dono() && criativoValido()
        && request.resource.data.produtoId == resource.data.produtoId
        && request.resource.data.criadoEm == resource.data.criadoEm;
    }

    match /oportunidades/{id} {
      allow read, delete: if dono();
      allow create: if novoDono()
        && request.resource.data.keys().hasOnly(['donoId', 'nicho', 'dados', 'criadoEm'])
        && textoAte(request.resource.data.nicho, 140)
        && request.resource.data.dados is map
        && request.resource.data.criadoEm == request.time;
    }

    // Status da conexão com o gateway (os tokens ficam em conexoes_mp, sem nenhuma regra de leitura).
    match /integracoes/{uid} { allow read: if eu(uid); }
    match /metricas/{id} { allow read: if dono(); }

    // Leitura do próprio dono; escrita só pelo servidor.
    match /{colecao}/{id} {
      allow read: if colecao in ['creditos', 'assinaturas'] && eu(id);
    }
    match /consumo_ia/{id} { allow read: if dono(); }
    match /movimentos_creditos/{id} { allow read: if dono(); }
    match /pagamentos_assinatura/{id} { allow read: if dono(); }
    match /configuracoes/{id} { allow read: if logado(); }
    match /jobs/{id} { allow read: if dono(); }
    match /pedidos/{id} { allow read: if logado() && resource.data.vendedorId == request.auth.uid; }

    match /planos/{id} { allow read: if true; }
    // Página de vendas: o id do documento É o endereço (/p/{slug}), então dois produtos nunca disputam a mesma URL.
    // "checkoutAtivo" só o servidor escreve (Etapa 5, parte 2): sem ele a página pública não mostra botão de compra.
    match /paginas_vendas/{slug} {
      // Checkout externo só em domínios das próprias plataformas: página pública não redireciona para qualquer lugar.
      function linkVenda(v) { return v == null || (v is string && v.size() <= 500 && v.matches('https://(pay[.]kiwify[.]com[.]br|([a-z0-9-]+[.])?kiwify[.]app|pay[.]hotmart[.]com|go[.]hotmart[.]com|hotm[.]art)(/.*)?')); }
      function vendaValida(v) { return v == null || (v is map && v.plataforma in ['mercadopago', 'kiwify', 'hotmart'] && linkVenda(v.get('link', null)) && linkVenda(v.get('linkPromo', null))); }
      function paginaValida() {
        let d = request.resource.data;
        return d.keys().hasOnly(['donoId', 'produtoId', 'slug', 'modelo', 'cores', 'fontes', 'conteudo', 'secoes', 'oferta', 'capa', 'capaUrl', 'seo', 'publicada', 'publicadaEm', 'checkoutAtivo', 'venda', 'atualizadoEm'])
          && d.slug == slug && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && slug.size() >= 3 && slug.size() <= 60
          && d.modelo in ['impacto', 'editorial', 'essencial']
          && d.publicada is bool
          && vendaValida(d.get('venda', null))
          && d.atualizadoEm == request.time
          && get(/databases/$(database)/documents/produtos/$(d.produtoId)).data.donoId == request.auth.uid;
      }
      // resource == null: endereço livre pode ser consultado antes de ser ocupado.
      allow read: if resource == null || resource.data.publicada == true || dono();
      allow create: if novoDono() && paginaValida() && request.resource.data.get('checkoutAtivo', false) == false && liberado();
      allow update: if dono() && novoDono() && paginaValida()
        && request.resource.data.produtoId == resource.data.produtoId
        && request.resource.data.get('checkoutAtivo', false) == resource.data.get('checkoutAtivo', false);
      allow delete: if dono();
    }

    // Cupons: o dono cria e ativa/desativa; a contagem de usos é do servidor.
    match /cupons/{id} {
      allow read, delete: if dono();
      allow create: if novoDono()
        && request.resource.data.keys().hasOnly(['donoId', 'produtoId', 'codigo', 'tipo', 'valor', 'validoAte', 'usosMax', 'usos', 'ativo', 'criadoEm'])
        && request.resource.data.codigo.matches('^[A-Z0-9]{3,20}$')
        && request.resource.data.tipo in ['percentual', 'valor']
        && request.resource.data.valor is int && request.resource.data.valor > 0
        && (request.resource.data.tipo != 'percentual' || request.resource.data.valor <= 90)
        && request.resource.data.usos == 0
        && request.resource.data.ativo is bool
        && request.resource.data.criadoEm == request.time;
      allow update: if dono() && soMudou(['ativo']) && request.resource.data.ativo is bool;
    }
  }
}
