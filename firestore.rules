rules_version = '2';

// Regra geral: tudo negado. Cada coleção abre só o necessário.
// Campos sensíveis (créditos, assinatura, pedidos, pagamentos, papel) só o servidor escreve (Admin SDK ignora estas regras).
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu(uid) { return logado() && request.auth.uid == uid; }
    function dono() { return logado() && resource.data.donoId == request.auth.uid; }
    function novoDono() { return logado() && request.resource.data.donoId == request.auth.uid; }
    function soMudou(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    function textoAte(v, max) { return v is string && v.size() <= max; }

    match /usuarios/{uid} {
      allow read: if eu(uid);
      allow create: if eu(uid)
        && request.resource.data.keys().hasOnly(['nome', 'email', 'criadoEm', 'aceite'])
        && textoAte(request.resource.data.nome, 120)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.criadoEm == request.time
        && request.resource.data.aceite.versao is string
        && request.resource.data.aceite.em == request.time;
      allow update: if eu(uid) && soMudou(['nome']) && textoAte(request.resource.data.nome, 120);
      allow delete: if false;
    }

    match /produtos/{id} {
      function produtoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['donoId', 'titulo', 'status', 'etapa', 'configuracao', 'planejamento', 'planejamentoAprovado', 'identidade', 'criadoEm', 'atualizadoEm'])
          && textoAte(d.titulo, 120)
          && d.status in ['rascunho', 'em_edicao']   // 'publicado' só o servidor marca (Etapa 5)
          && d.etapa is int && d.etapa >= 0 && d.etapa <= 6
          && d.configuracao is map
          && (!('planejamento' in d) || d.planejamento == null || d.planejamento is map)
          && (!('planejamentoAprovado' in d) || d.planejamentoAprovado is bool)
          && (!('identidade' in d) || d.identidade is map)
          && d.atualizadoEm == request.time;
      }
      allow read: if dono();
      allow create: if novoDono() && produtoValido() && request.resource.data.criadoEm == request.time;
      allow update: if dono() && novoDono() && produtoValido()
        && request.resource.data.criadoEm == resource.data.criadoEm
        && resource.data.status != 'publicado';
      allow delete: if dono() && resource.data.status != 'publicado';
    }

    // Capítulos: um documento por capítulo, sempre ligado a um produto do próprio dono.
    match /capitulos/{id} {
      function capituloValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['donoId', 'produtoId', 'ordem', 'titulo', 'status', 'conteudo', 'resumo', 'problemas', 'revisaoAplicada', 'erro', 'editadoManualmente', 'atualizadoEm'])
          && d.ordem is int && d.ordem >= 0 && d.ordem < 60
          && textoAte(d.titulo, 200)
          && d.status in ['pendente', 'gerando', 'concluido', 'erro']
          && (!('conteudo' in d) || textoAte(d.conteudo, 300000))
          && (!('resumo' in d) || textoAte(d.resumo, 4000))
          && d.atualizadoEm == request.time
          && get(/databases/$(database)/documents/produtos/$(d.produtoId)).data.donoId == request.auth.uid;
      }
      allow read: if dono();
      allow create: if novoDono() && capituloValido();
      allow update: if dono() && novoDono() && capituloValido() && request.resource.data.produtoId == resource.data.produtoId;
      allow delete: if dono();
    }

    // Imagens geradas: o arquivo fica no Storage (criadores/{uid}/...); aqui só o registro.
    match /imagens/{id} {
      allow read, delete: if dono();
      allow create: if novoDono()
        && request.resource.data.keys().hasOnly(['donoId', 'produtoId', 'tipo', 'ordem', 'url', 'caminho', 'prompt', 'criadoEm'])
        && request.resource.data.tipo in ['capa', 'capitulo']
        && request.resource.data.ordem is int
        && request.resource.data.url is string && request.resource.data.url.matches('https://firebasestorage[.]googleapis[.]com/.*')
        && request.resource.data.caminho.matches('criadores/' + request.auth.uid + '/.*')
        && textoAte(request.resource.data.prompt, 4000)
        && request.resource.data.criadoEm == request.time
        && get(/databases/$(database)/documents/produtos/$(request.resource.data.produtoId)).data.donoId == request.auth.uid;
    }

    // Versões do PDF: o arquivo fica no Storage do criador; aqui o histórico.
    match /arquivos/{id} {
      allow read: if dono();
      allow create: if novoDono()
        && request.resource.data.keys().hasOnly(['donoId', 'produtoId', 'versao', 'url', 'caminho', 'paginas', 'bytes', 'rascunho', 'criadoEm'])
        && request.resource.data.versao is int
        && request.resource.data.url.matches('https://firebasestorage[.]googleapis[.]com/.*')
        && request.resource.data.caminho.matches('criadores/' + request.auth.uid + '/.*')
        && request.resource.data.criadoEm == request.time
        && get(/databases/$(database)/documents/produtos/$(request.resource.data.produtoId)).data.donoId == request.auth.uid;
    }

    match /oportunidades/{id} {
      allow read, delete: if dono();
      allow create: if novoDono()
        && request.resource.data.keys().hasOnly(['donoId', 'nicho', 'dados', 'criadoEm'])
        && textoAte(request.resource.data.nicho, 140)
        && request.resource.data.dados is map
        && request.resource.data.criadoEm == request.time;
    }

    // Leitura do próprio dono; escrita só pelo servidor.
    match /{colecao}/{id} {
      allow read: if colecao in ['creditos', 'assinaturas'] && eu(id);
    }
    match /consumo_ia/{id} { allow read: if dono(); }
    match /jobs/{id} { allow read: if dono(); }
    match /pedidos/{id} { allow read: if logado() && resource.data.vendedorId == request.auth.uid; }

    match /planos/{id} { allow read: if true; }
    match /paginas_vendas/{id} { allow read: if resource.data.publicada == true || dono(); }
  }
}
